                "parameter": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "numeric",
                    "range",
                    "qualitative"
                  ]
                },
                "about": {
                  "enum": [
                    "subject",
                    "target",
                    "experiment"
                  ]
                }
              },
              "required": [
                "parameter",
                "value",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "outcomes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "indicator": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "numeric",
                    "qualitative",
                    "ordinal"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "direction": {
                  "enum": [
                    "increase",
                    "decrease",
                    "no_effect",
                    "mixed",
                    "unknown"
                  ]
                },
                "stage": {
                  "type": "string",
                  "minLength": 1
                },
                "baseline": {
                  "type": "string",
                  "minLength": 1
                },
                "baseline_quote": {
                  "type": "string",
                  "minLength": 1
