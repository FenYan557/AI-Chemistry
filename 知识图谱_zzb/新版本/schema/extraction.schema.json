          },
          "statement": {
            "enum": [
              "observation",
              "calculation_result",
              "author_interpretation",
              "future_work",
              "reported_claim",
              "unknown"
            ]
          },
          "modality": {
            "enum": [
              "explicit",
              "hedged",
              "speculative",
              "unknown"
