          "target": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "effect",
              "adsorption",
              "measurement",
              "mechanism",
              "future_work",
              "other",
              "composition",
              "method_setting",
              "has_property",
              "used_in",
              "joint_mechanism",
              "calculated_property",
              "candidate_selection"
