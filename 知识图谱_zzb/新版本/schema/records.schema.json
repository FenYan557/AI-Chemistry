  },
  "required": [
    "schema_version",
    "documents",
    "blocks",
    "mentions",
    "facts"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "block",
            "table_cell"
          ]
        },
        "block_id": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string"
        },
        "table_id": {
          "type": "string"
        },
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "col": {
          "type": "integer",
          "minimum": 0
        },
        "cell_raw": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "block"
              }
            }
          },
          "then": {
            "required": [
              "block_id",
              "start",
              "end",
              "quote"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "table_cell"
              }
            }
          },
          "then": {
            "required": [
              "table_id",
              "row",
              "col",
              "cell_raw"
            ]
          }
        }
      ]
    },
    "quantity": {
      "type": "object",
      "properties": {
        "value_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "value_kind": {
          "enum": [
