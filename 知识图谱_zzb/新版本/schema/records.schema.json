{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a2lab:literature-kg:4.0.0-draft",
  "title": "专题文献事实记录 v4：精简模型输入、代码补齐与可核查图视图",
  "$comment": "按九项组织：本文件只放记录契约；类型判据/关系签名/词表/标识规则/消费端契约在 registry/，约束与三档在 schema/constraints.json。校验通过不表示化学结论正确。",
  "x-nine-items": [
    {
      "item": "1",
      "title": "实体类型（节点类）",
      "where": "registry/entity_types.json",
      "mechanism": "判据/正例/反例/边界；无判据不可实例化（ENTITY_TYPE_UNDERSPECIFIED）"
    },
    {
      "item": "2",
      "title": "关系定义域与值域（签名）",
      "where": "registry/relations.json",
      "mechanism": "只有启用且角色签名明确的关系生成边；开放关系保留事实用于检索"
    },
    {
      "item": "3",
      "title": "标识与唯一性",
      "where": "registry/identity_rules.json + identity_merges",
      "mechanism": "ID 规则；合并/拆分/拒并留痕；pending 合并不生效"
    },
    {
      "item": "4",
      "title": "属性表示边界",
      "where": "registry/vocab.json#representation_policy",
      "mechanism": "何时升节点、何时留属性；跨实验比较须先值化"
    },
    {
      "item": "5",
      "title": "受控词表与枚举",
      "where": "registry/vocab.json + registry/roles.json",
      "mechanism": "封闭取值与 schema 枚举逐项一致；候选晋升需依据"
    },
    {
      "item": "6",
      "title": "约束与处置",
      "where": "schema/constraints.json",
      "mechanism": "block/review/warn 三档 × 执行点；未登记码报 CONSTRAINT_CATALOG_GAP"
    },
    {
      "item": "7",
      "title": "上下文与 n-ary",
      "where": "facts（文献陈述）+ edges（角色投影视图）+ outcome.magnitude/comparison",
      "mechanism": "条件挂事实；程度与比较基准显式；边不得自带新语义"
    },
    {
      "item": "8",
      "title": "溯源与可信度",
      "where": "facts 的 statement_type/source_scope/polarity/modality/cited_work/extraction",
      "mechanism": "陈述归属与人工审核分开；pending不自动禁止忠实引用"
    },
    {
      "item": "9",
      "title": "演化与治理",
      "where": "schema/constraints.json#budget + registry/vocab.json#promotion",
      "mechanism": "预算上限、迁移规则、晋升流程、命名与审计"
    },
    {
      "item": "补1",
      "title": "消费端契约",
      "where": "registry/consumer_contract.json",
      "mechanism": "事实级检索；引用、数值比较、候选建议分别判断，不用A–E总档"
    },
    {
      "item": "补2",
      "title": "复用成熟标准",
      "where": "registry/standards_mapping.json",
      "mechanism": "PROV-O/SOSA/QUDT/ChEBI 字段映射；未核对术语留 null"
    }
  ],
  "type": "object",
  "properties": {
